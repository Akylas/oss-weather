plugin 'cocoapods-acknowledgements'
platform :ios, '13.0'
post_install do |installer|
    installer.pods_project.targets.each do |target|
        target.build_configurations.each do |config|
            config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '12.0'
            # Mac Catalyst: pods default to macOS 11.0, below the 12.0 minimum of Xcode 27. The app's own
            # target is 12.0 (App_Resources/Catalyst/build.xcconfig)
            config.build_settings['MACOSX_DEPLOYMENT_TARGET'] = '12.0'
            # same for Catalyst, whose macOS target comes from the iOS one (15.0 = macOS 12.0)
            config.build_settings['IPHONEOS_DEPLOYMENT_TARGET[sdk=macosx*]'] = '17.0'
            # CocoaPods only clears the identity for iOS SDKs: Catalyst pods would need a
            # "Mac Development" cert. Sign them ad-hoc, the embed phase re-signs with the app identity.
            config.build_settings['CODE_SIGN_IDENTITY[sdk=macosx*]'] = '-'
            config.build_settings['SWIFT_VERSION'] = '5.1'
            config.build_settings['DEVELOPMENT_TEAM'] = '3UUB5NM43K'
            config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
            config.build_settings['OTHER_SWIFT_FLAGS'] = '-DSUPPRESS_WARNINGS'
        end
    end
end